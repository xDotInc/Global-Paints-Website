# Vercel CLI reads .env.local (not .env) for local development.
# Copy this file to .env.local for local `vercel dev` testing.
# Never commit your real .env.local to version control.

# Password used to log into /admin.html. Choose a strong, unique password.
ADMIN_PASSWORD=change-this-password

# Long random string used to sign admin login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- Everything below this line is normally auto-generated ---
#
# Once you connect an Upstash Redis database and a Vercel Blob store to
# this project (Vercel dashboard → your project → Storage tab), Vercel
# injects these automatically in production. For local development, run:
#   vercel link
#   vercel env pull .env.local
# instead of typing these in by hand — that command fetches the real
# values (plus ADMIN_PASSWORD/JWT_SECRET if you've already set them in the
# dashboard) into this file for you.
#
# Vercel's current Upstash integration names these KV_REST_API_URL /
# KV_REST_API_TOKEN (a naming holdover from the old "Vercel KV" product).
# The code also accepts the older UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN naming if that's what you see instead — either
# works, you don't need to rename anything yourself.
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
